# ===== 知南·Echo 环境配置 =====
# 复制为 .env 后填写。所有 LLM/Embedding 配置均可留空，
# 留空时系统自动降级为「本地规则模式」，核心功能开箱即用。

# ---- LLM（OpenAI 兼容协议，默认 DeepSeek）----
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- Embedding（OpenAI 兼容协议，推荐 SiliconFlow 的 BGE-M3）----
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---- 数据库（默认本地 SQLite，比赛部署可切 PostgreSQL）----
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/zhinan

# ---- JWT ----
JWT_SECRET=please-change-me-in-production

# ---- 邮件提醒（可选，配置后 DDL 提醒将同时发送邮件）----
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
